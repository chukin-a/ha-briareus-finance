{
  "name": "ha-finance-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "prebuild": "npm run clean",
    "build": "nest build",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs",
    "seed:money-flow": "npm run build && node scripts/seed-money-flow.mjs",
    "seed:credit-cards": "npm run build && node scripts/seed-credit-cards.mjs",
    "seed:project-transactions": "npm run build && node scripts/seed-project-transactions.mjs",
    "normalize:dev-ids": "node scripts/normalize-dev-ids.mjs",
    "sanitize:dev-data": "node scripts/sanitize-dev-data.mjs",
    "seed:test-users": "node scripts/seed-test-users.mjs",
    "seed:analytics-density": "node scripts/seed-analytics-density.mjs",
    "normalize:test-categories": "node scripts/normalize-test-categories.mjs",
    "normalize:test-accounts": "node scripts/normalize-test-accounts.mjs",
    "repair:test-data": "node scripts/repair-test-data.mjs",
    "seed:planning-data": "node scripts/seed-planning-data.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "better-sqlite3": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  }
}
